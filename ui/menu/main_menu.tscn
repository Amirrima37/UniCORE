theme_override_colors/font_color = Color(0.8, 0.88, 0.95, 0.9)
theme_override_font_sizes/font_size = 12
text = "UniCORE — это открытая расширяемая среда, в которую встроен автономный ИИ-Агент.
Ядро является стерильным, а вся функциональность мира монтируется динамически в виде GDScript-модулей.
Дизайн оболочки вдохновлен интерфейсами Detroit: Become Human (матовое стекло, неоновые LED-акценты)."
autowrap_mode = 3

