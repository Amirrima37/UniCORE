extends SceneTree
const Document = preload("res://core/cae/cae_document.gd")
func _init():
	var d = Document.new()
	assert(d.execute("CreatePartDefinition", {"kind":"Box"}).is_empty())
	var definition = d.data.parts[0].definition_uuid
	var geometry = d.data.part_definitions.duplicate(true)
	assert(d.execute("AddInstance", {"definition_uuid":definition}).is_empty())
	assert(d.data.parts.size()==2)
	assert(d.data.parts[0].instance_uuid != d.data.parts[1].instance_uuid)
	assert(d.execute("TranslateInstance", {"index":1,"values":[3,0,0]}).is_empty())
	assert(d.execute("RotateInstance", {"index":1,"values":[0,0,PI/2]}).is_empty())
	assert(d.data.parts[0].position == [0.0,0.0,0.0])
	assert(d.data.part_definitions == geometry)
	assert(d.data.parts[1].transformation_revision == 2)
	assert(d.generate_mesh(1).is_empty())
	var nodes = d.data.mesh.nodes
	assert(abs(nodes[8][0]-3.1)<1e-5)
	var path = OS.get_environment("UNICORE_ASSEMBLY_TEST_FILE")
	assert(not path.is_empty())
	assert(d.save_project(path)==OK)
	var reopened = Document.new()
	var error = reopened.open_project(path)
	print("OPEN: ",error)
	assert(error.is_empty())
	assert(reopened.data.parts[1].instance_uuid == d.data.parts[1].instance_uuid)
	assert(reopened.data.parts[1].definition_uuid == definition)
	assert(abs(reopened.data.parts[1].rotation[2]-PI/2)<1e-12)
	assert(reopened.data.part_definitions.has(definition))
	assert(reopened.execute("RemoveInstance", {"index":1}).is_empty())
	assert(reopened.data.parts.size()==1)
	var legacy = d.data.duplicate(true)
	legacy.erase("assembly_schema")
	legacy.erase("part_definitions")
	for part in legacy.parts:
		for key in ["definition_uuid","instance_uuid","geometry_revision","transformation_revision"]: part.erase(key)
	var f = FileAccess.open(path+".legacy",FileAccess.WRITE)
	f.store_string(JSON.stringify(legacy));f.close()
	assert(reopened.open_project(path+".legacy").is_empty())
	assert(reopened.data.parts.size()==2)
	assert(reopened.execute("DuplicateInstance", {"index":0}).is_empty())
	assert(reopened.data.parts[2].definition_uuid == reopened.data.parts[0].definition_uuid)
	assert(reopened.execute("AssignMaterial", {"index":2,"material":{"name":"Independent", "E":100e9,"nu":0.3,"density":1000.0}}).is_empty())
	assert(reopened.data.parts[0].material.name == "Steel")
	assert(reopened.execute("SetVisibility", {"index":2,"visible":false}).is_empty())
	assert(reopened.data.parts[0].visible)
	assert(reopened.execute("SetDimensions", {"index":2,"values":[2,1,1]}).is_empty())
	assert(reopened.data.parts[2].definition_uuid != reopened.data.parts[0].definition_uuid)
	reopened.undo()
	assert(reopened.data.parts[2].definition_uuid == reopened.data.parts[0].definition_uuid)
	print("ASSEMBLY_PASS ", JSON.stringify(d.data.parts))
	quit()


