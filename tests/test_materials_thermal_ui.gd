extends SceneTree
var failures:=0
func check(ok: bool,message: String):
	if not ok: failures+=1; push_error(message)
func _initialize():
	create_timer(30).timeout.connect(func(): quit(2))
	GDExtensionManager.load_extension("res://bin/unicore_native.gdextension")
	var library=load("res://core/cae/material_library.gd").new()
	var alloy: Dictionary=library.find_material("Aluminum 6061-T6")
	check(not alloy.is_empty() and alloy.sources.size()>0,"Traceable material found")
	check(library.validate(alloy,"static_structural").ok,"6061 mechanical record ready")
	var stainless: Dictionary=library.find_material("Stainless steel 316")
	check(not library.validate(stainless,"static_structural").ok and library.validate(stainless,"steady_thermal").ok,"Missing Poisson ratio is not invented")
	var timber: Dictionary=library.find_material("Structural timber")
	check(not library.validate(timber,"static_structural").ok,"Unsupported orthotropic model rejected")
	var workspace=load("res://ui/cae/cae_workspace.gd").new()
	root.add_child.call_deferred(workspace)
	await process_frame
	workspace.set_active(true)
	workspace.create_part("Box")
	workspace.run_command("AssignMaterialById",{"material_id":"Aluminum 6061-T6"})
	check(workspace.document.data.parts[0].material.id==alloy.id,"Library assignment stores complete material record")
	workspace.open_material_library()
	check(workspace.material_editor.visible,"Material editor opens")
	check(workspace.material_editor.list.item_count>=33,"All material records visible without a search filter")
	workspace.material_editor.search.text="316"
	workspace.material_editor.search.text_changed.emit("316")
	check(workspace.material_editor.list.item_count==1,"Material search filters records")
	workspace.material_editor.handle_action("New")
	check(JSON.parse_string(workspace.material_editor.editor.text) is Dictionary,"Custom material definition editor")
	workspace.dismiss_dialogs()
	workspace.open_analysis_editor()
	check(workspace.analysis_editor.visible,"Analysis editor opens")
	workspace.dismiss_dialogs()
	workspace.run_command("AssignMaterialById",{"material_id":"Stainless steel 316"})
	workspace.document.execute("SetAnalysis",{"analysis":{"type":"steady_thermal","element":"TET4"}})
	workspace.run_command("ApplyThermalBoundary",{"boundary":{"face":"X-","kind":"temperature","value":300}})
	workspace.run_command("ApplyThermalBoundary",{"boundary":{"face":"X+","kind":"temperature","value":400}})
	check(workspace.document.validate().is_empty(),"Thermal document validates without structural supports")
	workspace.solve()
	while workspace.solve_thread!=null: await process_frame
	check(workspace.results_current() and workspace.document.data.results.has("temperature"),"Thermal worker result associated with current model")
	workspace.show_result_inspector()
	workspace.select_result_field("temperature")
	check(workspace.cad.overlay_root.get_child_count()>0,"Actual temperature surface created")
	check(workspace.document.save_project("res://.tools/materials-thermal.ucae")==OK,"Save material and thermal result")
	var restored=load("res://core/cae/cae_document.gd").new()
	check(restored.open_project("res://.tools/materials-thermal.ucae")=="","Reopen incomplete mechanical material and thermal result")
	check(restored.data.parts[0].material.sources.size()>0,"Material provenance persists")
	print("Materials and thermal workspace checks: ",failures," failures")
	workspace.queue_free()
	await process_frame
	quit(1 if failures else 0)
