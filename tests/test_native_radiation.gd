extends SceneTree
func _initialize():
	create_timer(60).timeout.connect(func():quit(2))
	GDExtensionManager.load_extension("res://bin/unicore_native.gdextension")
	var doc=load("res://core/cae/cae_document.gd").new()
	doc.execute("CreatePart");doc.execute("SetDimensions",{"index":0,"values":[1,1,1]})
	doc.execute("AssignMaterialById",{"index":0,"material_id":"Stainless steel 316"})
	doc.execute("SetAnalysis",{"analysis":{"type":"steady_thermal"}})
	for face in ["X-","X+","Y-","Y+","Z-","Z+"]:assert(doc.execute("ApplyThermalBoundary",{"index":0,"boundary":{"kind":"temperature","face":face,"value":600}})=="")
	assert(doc.execute("ApplyThermalBoundary",{"index":0,"boundary":{"kind":"radiation","face":"X+","emissivity":0.8,"surroundings":300}})=="")
	doc.generate_mesh(2)
	var solver=ClassDB.instantiate("UniCoreThermalSolver")
	var r: Dictionary=solver.solve_model(doc.data)
	assert(r.ok)
	var reference:=0.8*5.670374419e-8*(pow(600,4)-pow(300,4))
	assert(abs(r.radiation_loss_W-reference)<1e-6)
	assert(abs(r.energy_balance_W)<1e-5)
	assert(r.nonlinear_iterations>=0 and r.has("nonlinear_residual_history"))
	print("Radiation GDExtension flux ",r.radiation_loss_W," W; reference ",reference," W; balance ",r.energy_balance_W)
	var bad: Dictionary=doc.data.duplicate(true)
	bad.parts[0].thermal[-1].emissivity=1.1
	assert(not solver.solve_model(bad).ok)
	bad=doc.data.duplicate(true);bad.parts[0].thermal[-1].surroundings=-1
	assert(not solver.solve_model(bad).ok)
	bad=doc.data.duplicate(true);bad.parts[0].thermal[-1].use_material_emissivity=true;bad.parts[0].material.erase("emissivity")
	assert(not solver.solve_model(bad).ok)
	var file:=FileAccess.open("res://docs/cae-upgrade/radiation-binding.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"flux_W_m2":reference,"power_W":r.radiation_loss_W,"energy_balance_W":r.energy_balance_W,"nonlinear_iterations":r.nonlinear_iterations},"\t"))
	print("Native radiation binding: 0 failures")
	quit()
