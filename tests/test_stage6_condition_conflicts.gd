extends SceneTree
func _initialize():
	var doc=load("res://core/cae/cae_document.gd").new()
	doc.execute("CreatePart",{"kind":"Sphere","parameters":{"radius":0.1}})
	assert(doc.execute("ApplyPressure",{"index":0,"face":"OuterSurface","value":1.0}).is_empty())
	var before: Dictionary=doc.data.duplicate(true)
	assert(not doc.execute("ApplyLoad",{"index":0,"face":"PositiveY","force":[0,1,0]}).is_empty())
	assert(doc.data==before)
	doc.execute("ClearAnalysisConditions",{"index":0})
	assert(doc.execute("ApplyThermalBoundary",{"index":0,"boundary":{"face":"OuterSurface","kind":"temperature","value":300.0}}).is_empty())
	before=doc.data.duplicate(true)
	assert(not doc.execute("ApplyThermalBoundary",{"index":0,"boundary":{"face":"PositiveY","kind":"flux","value":1.0}}).is_empty())
	assert(doc.data==before)
	doc.execute("ClearAnalysisConditions",{"index":0})
	for region in ["PositiveY","NegativeY"]:assert(doc.execute("ApplyThermalBoundary",{"index":0,"boundary":{"face":region,"kind":"temperature","value":300.0 if region=="PositiveY" else 400.0}}).is_empty())
	assert(doc.generate_mesh(1).is_empty())
	assert(load("res://core/cae/condition_conflicts.gd").error(doc.data.parts[0],doc.data.mesh).contains("Conflicting temperatures"))
	print("Atomic sphere overlap rejection and shared-node temperature conflict PASS")
	quit()
