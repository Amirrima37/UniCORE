# Godot 4+ specific ignores
.godot/
__pycache__/
*.py[cod]
*.translation

# Godot-specific exclusions
# Mono-specific ignores (if C# is used in future)
.mono/
data_*/
mono_crash.*.json

# System / OS ignores
.DS_Store
Thumbs.db

# Executables
*.exe

# Temporary & logs
run_output.txt
*.log

# Local native build dependencies and outputs
.tools/
native/godot-cpp/
native/.sconsign*
*.o
*.obj
*.dll
*.a
*.lib
bin/unicore_native.gdextension

# Local build trees (keep build scripts and dependency manifests tracked)
/native/build/
/native/build-*/
/native/.cache/
.sconsign.dblite
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.pdb
*.ilk
*.exp

# Python environments and test/tool caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Personal editor settings and temporary files
.vs/
.idea/
*.swp
*.swo
*~

# Local secrets (retain shareable example configuration)
.env
.env.local
.env.*.local
