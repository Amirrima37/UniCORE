cmake_minimum_required(VERSION 3.20)
project(UniCOREExtreme LANGUAGES CXX)
add_library(unicore_compute INTERFACE)
target_include_directories(unicore_compute INTERFACE ../src)
target_compile_features(unicore_compute INTERFACE cxx_std_17)
if(MSVC)
 target_compile_options(unicore_compute INTERFACE /fp:strict)
else()
 target_compile_options(unicore_compute INTERFACE -ffp-contract=off)
endif()
find_package(OpenMP)
if(OpenMP_CXX_FOUND)
 target_link_libraries(unicore_compute INTERFACE OpenMP::OpenMP_CXX)
endif()
add_executable(unicore_solver main.cpp)
target_link_libraries(unicore_solver PRIVATE unicore_compute psapi bcrypt)
if(MINGW)
 target_link_options(unicore_solver PRIVATE -municode)
endif()
if(OpenMP_CXX_FOUND)
 add_executable(unicore_pcg_benchmark benchmark.cpp)
 target_link_libraries(unicore_pcg_benchmark PRIVATE unicore_compute)
endif()

enable_testing()
add_executable(unicore_parallel_assembly_test ../tests/parallel_assembly_test.cpp)
target_link_libraries(unicore_parallel_assembly_test PRIVATE unicore_compute)
add_test(NAME parallel_assembly COMMAND unicore_parallel_assembly_test)
if(OpenMP_CXX_FOUND)
 add_executable(unicore_assembly_benchmark assembly_benchmark.cpp)
 target_link_libraries(unicore_assembly_benchmark PRIVATE unicore_compute)
endif()

add_executable(unicore_sparse_preconditioner_test ../tests/sparse_preconditioner_test.cpp)
target_link_libraries(unicore_sparse_preconditioner_test PRIVATE unicore_compute)
add_test(NAME sparse_preconditioner COMMAND unicore_sparse_preconditioner_test)

add_executable(unicore_modal_test ../tests/modal_test.cpp)
target_link_libraries(unicore_modal_test PRIVATE unicore_compute)
add_test(NAME modal COMMAND unicore_modal_test)
